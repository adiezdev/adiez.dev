---
import Layout from "../layouts/Layout.astro";
import Divider from "../components/ui/Divider.astro";
import Chips from "../components/ui/Chips.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import profilePic from "../assets/profile.jpg";
import { personalProfile } from "../lib/personalProfile";
---

<Layout>
	<section class="hero">
		<div class="hero-container">
			<div class="profile-image-wrapper">
				<img src={profilePic.src} alt="Profile" />
			</div>
			<div class="hero-content">
				<h1>{SITE_TITLE}</h1>
				<p class="hero-description">{SITE_DESCRIPTION}</p>
			</div>
		</div>
	</section>
	<button
		onclick="document.getElementById('Experiencia').scrollIntoView({ behavior: 'smooth' })"
		class="button-custom">Saber mas</button
	>
	<section>
		<h2 id="Experiencia" class="Experiencia">Experiencia</h2>
		<div class="works">
			{
				personalProfile.professional.works.map((work) => (
					<article>
						<h3>{work.name}</h3>
						<p>{work.status}</p>
						<Chips chips={work.tech} />
						<p>{work.description}</p>
						<details>
							<summary>Responsabilidades</summary>
							<ul>
								{work.responsibilities.map((responsibility) => (
									<li>{responsibility}</li>
								))}
							</ul>
						</details>
						<Divider />
					</article>
				))
			}
		</div>
	</section>
	<style>
		.hero {
			text-align: center;
			padding: 2rem 0;
		}

		.hero-container {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 2rem;
		}

		.hero-content {
			text-align: left;
		}

		.hero h1 {
			margin-bottom: 1rem;
		}

		.hero-description {
			font-size: 1.25rem;
			color: var(--text-secondary);
			max-width: 600px;
			margin: 0;
		}

		.profile-image-wrapper {
			width: 55vw;
		}
		.button-custom {
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto;
			padding: 0.6rem 1.5rem;
			background-color: var(--accent-glow);
			color: var(--text-primary);
		}
		.Experiencia {
			font-weight: 700;
			color: var(--text-primary);
			border-bottom: 3px dashed var(--text-secondary);
		}
		@media (max-width: 600px) {
			.hero-container {
				flex-direction: column;
				text-align: center;
				gap: 40px;
			}

			.hero-content {
				text-align: center;
			}

			.profile-image-wrapper {
				width: 200px;
				height: 240px;
			}
		}
	</style>
</Layout>
