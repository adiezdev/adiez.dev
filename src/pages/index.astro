---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Chips from "../components/ui/Chips.astro";
import Portfolio from "../components/Portfolio.astro";
import { CONTACT_EMAIL, SITE_AUTHOR, SITE_DESCRIPTION, SOCIAL } from "../consts";
import profilePic from "../assets/profile.jpg";
import { personalProfile } from "../lib/personalProfile";
---

<Layout>
	<section class="hero">
		<div class="hero-container">
			<div class="profile-image-wrapper">
				<!-- Se pinta a 200px en móvil y como mucho 300px en escritorio -->
				<Image
					src={profilePic}
					width={600}
					widths={[200, 300, 400, 600]}
					sizes="(max-width: 600px) 200px, 300px"
					alt="Alejandro Díez López"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<div class="hero-content">
				<h1>{SITE_AUTHOR}</h1>
				<p class="hero-role">{personalProfile.role}</p>
				<p class="hero-description">{SITE_DESCRIPTION}</p>
			</div>
		</div>
	</section>
	<section class="buttons">
		<button
			onclick="document.getElementById('Experiencia').scrollIntoView({ behavior: 'smooth' })"
			class="button-custom">Saber más</button
		>
		<button onclick="window.location.href = '/ai'" class="button-secondary"
			>Modo IA</button
		>
	</section>
	<section>
		<h2 id="Experiencia" class="Experiencia">Experiencia</h2>
		<ol class="works">
			{
				personalProfile.professional.works.map((work) => (
					<li class="work">
						<p class="work-date">{work.status}</p>
						<h3>{work.name}</h3>
						<p>{work.description}</p>
						<Chips chips={work.tech} />
						<details>
							<summary>Responsabilidades</summary>
							<ul>
								{work.responsibilities.map((responsibility) => (
									<li>{responsibility}</li>
								))}
							</ul>
						</details>
					</li>
				))
			}
		</ol>
	</section>
	<Portfolio />
	<section class="contact" aria-labelledby="contacto">
		<h2 id="contacto">Contacto</h2>
		<p>¿Tienes un proyecto o una oferta? Escríbeme y te respondo.</p>
		<div class="contact-links">
			<a class="contact-primary" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			<a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</section>
</Layout>

<style>
	/* Línea de tiempo: línea vertical a la izquierda y un punto por trabajo */
	.works {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0 0 0 1.5rem;
		border-left: 2px solid var(--border-color);
	}

	.work {
		position: relative;
		padding-bottom: 2.5rem;
	}

	.work:last-child {
		padding-bottom: 0;
	}

	.work::before {
		content: "";
		position: absolute;
		left: calc(-1.5rem - 7px);
		top: 0.45rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--bg-primary);
		border: 2px solid var(--text-primary);
	}

	.work:first-child::before {
		background: var(--text-primary);
	}

	.work-date {
		margin: 0;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--text-muted);
		letter-spacing: 0.02em;
	}

	.work h3 {
		margin: 0.25rem 0 0.5rem;
	}

	.work p {
		color: var(--text-secondary);
	}

	.contact {
		text-align: center;
		padding: 2rem 0 1rem;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.contact-links a {
		padding: 0.6rem 1.5rem;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		background: var(--bg-tertiary);
	}

	.contact-links a:hover {
		border-color: var(--text-muted);
	}

	.contact-links .contact-primary {
		background: var(--accent);
		color: var(--bg-primary);
	}

	.hero {
		text-align: center;
		padding: 2rem 0;
	}

	.hero-container {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
	}

	.hero-content {
		text-align: left;
	}

	.hero h1 {
		margin-bottom: 0.25rem;
	}

	.hero-role {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0 0 1rem;
	}

	.hero-description {
		font-size: 1.25rem;
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0;
	}

	.profile-image-wrapper {
		width: min(40%, 300px);
		flex-shrink: 0;
	}
	.buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 3rem;
		.button-custom {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0.6rem 1.5rem;
			background-color: var(--accent-glow);
			color: var(--text-primary);
		}
	}
	.button-secondary {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem 1.5rem;
		background-color: var(--accent);
		color: var(--bg-primary);
		transition:
			box-shadow var(--transition-normal),
			transform var(--transition-normal);
	}
	/* Brillo arcoíris suave: guiño a la IA sin romper el tema monocromo */
	.button-secondary:hover,
	.button-secondary:focus-visible {
		transform: translateY(-2px);
		box-shadow:
			-8px 0 18px rgba(255, 128, 128, 0.75),
			0 -8px 18px rgba(255, 228, 136, 0.7),
			8px 0 18px rgba(128, 199, 255, 0.75),
			0 8px 18px rgba(142, 92, 255, 0.75);
	}
	@media (prefers-reduced-motion: reduce) {
		.button-secondary:hover,
		.button-secondary:focus-visible {
			transform: none;
		}
	}
	.Experiencia {
		font-weight: 700;
		color: var(--text-primary);
		border-bottom: 3px dashed var(--text-secondary);
	}
	@media (max-width: 600px) {
		.hero-container {
			flex-direction: column;
			text-align: center;
			gap: 40px;
		}

		.hero-content {
			text-align: center;
		}

		.profile-image-wrapper {
			width: 200px;
			height: 240px;
		}
	}
</style>
