---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Divider from "../components/ui/Divider.astro";
import Chips from "../components/ui/Chips.astro";
import Portfolio from "../components/Portfolio.astro";
import { CONTACT_EMAIL, SITE_AUTHOR, SITE_DESCRIPTION, SOCIAL } from "../consts";
import profilePic from "../assets/profile.jpg";
import { personalProfile } from "../lib/personalProfile";
---

<Layout>
	<section class="hero">
		<div class="hero-container">
			<div class="profile-image-wrapper">
				<!-- Se pinta a 200px en móvil y como mucho ~410px en escritorio -->
				<Image
					src={profilePic}
					width={820}
					widths={[200, 400, 600, 820]}
					sizes="(max-width: 600px) 200px, 410px"
					alt="Alejandro Díez López"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
			<div class="hero-content">
				<h1>{SITE_AUTHOR}</h1>
				<p class="hero-role">{personalProfile.role}</p>
				<p class="hero-description">{SITE_DESCRIPTION}</p>
			</div>
		</div>
	</section>
	<section class="buttons">
		<button
			onclick="document.getElementById('Experiencia').scrollIntoView({ behavior: 'smooth' })"
			class="button-custom">Saber más</button
		>
		<button onclick="window.location.href = '/ai'" class="button-secondary"
			>Modo IA</button
		>
	</section>
	<section>
		<h2 id="Experiencia" class="Experiencia">Experiencia</h2>
		<div class="works">
			{
				personalProfile.professional.works.map((work) => (
					<article>
						<h3>{work.name}</h3>
						<p>{work.status}</p>
						<Chips chips={work.tech} />
						<p>{work.description}</p>
						<details>
							<summary>Responsabilidades</summary>
							<ul>
								{work.responsibilities.map((responsibility) => (
									<li>{responsibility}</li>
								))}
							</ul>
						</details>
						<Divider />
					</article>
				))
			}
		</div>
	</section>
	<Portfolio />
	<section class="contact" aria-labelledby="contacto">
		<h2 id="contacto">Contacto</h2>
		<p>¿Tienes un proyecto o una oferta? Escríbeme y te respondo.</p>
		<div class="contact-links">
			<a class="contact-primary" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			<a href={SOCIAL.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
		</div>
	</section>
</Layout>

<style>
	.contact {
		text-align: center;
		padding: 2rem 0 1rem;
	}

	.contact-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem;
	}

	.contact-links a {
		padding: 0.6rem 1.5rem;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		background: var(--bg-tertiary);
	}

	.contact-links a:hover {
		border-color: var(--text-muted);
	}

	.contact-links .contact-primary {
		background: var(--accent);
		color: var(--bg-primary);
	}

	.hero {
		text-align: center;
		padding: 2rem 0;
	}

	.hero-container {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
	}

	.hero-content {
		text-align: left;
	}

	.hero h1 {
		margin-bottom: 0.25rem;
	}

	.hero-role {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		margin: 0 0 1rem;
	}

	.hero-description {
		font-size: 1.25rem;
		color: var(--text-secondary);
		max-width: 600px;
		margin: 0;
	}

	.profile-image-wrapper {
		width: 55vw;
	}
	.buttons {
		display: flex;
		justify-content: center;
		gap: 1rem;
		.button-custom {
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 0.6rem 1.5rem;
			background-color: var(--accent-glow);
			color: var(--text-primary);
		}
	}
	.button-secondary {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem 1.5rem;
		background-color: var(--accent);
		color: var(--bg-primary);
	}
	.button-secondary:hover {
		transition-duration: 0.3s;
		-webkit-box-shadow:
			5px 5px 15px 5px #ff8080,
			-9px 5px 15px 5px #ffe488,
			-7px -5px 15px 5px #8cff85,
			12px -5px 15px 5px #80c7ff,
			12px 10px 15px 7px #e488ff,
			-10px 10px 15px 7px #ff616b,
			-10px -7px 27px 1px #8e5cff,
			5px 5px 15px 5px rgba(0, 0, 0, 0);
		box-shadow:
			5px 5px 15px 5px #ff8080,
			-9px 5px 15px 5px #ffe488,
			-7px -5px 15px 5px #8cff85,
			12px -5px 15px 5px #80c7ff,
			12px 10px 15px 7px #e488ff,
			-10px 10px 15px 7px #ff616b,
			-10px -7px 27px 1px #8e5cff,
			5px 5px 15px 5px rgba(0, 0, 0, 0);
	}
	.Experiencia {
		font-weight: 700;
		color: var(--text-primary);
		border-bottom: 3px dashed var(--text-secondary);
	}
	@media (max-width: 600px) {
		.hero-container {
			flex-direction: column;
			text-align: center;
			gap: 40px;
		}

		.hero-content {
			text-align: center;
		}

		.profile-image-wrapper {
			width: 200px;
			height: 240px;
		}
	}
</style>
