---
const { chips } = Astro.props;
---

<section>
    <ul class="chips">
        {chips.map((chip: string) => <li class="chip">{chip}</li>)}
    </ul>
</section>
<style>
    .chips {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: flex-start;
        gap: 0.5rem;
        padding-left: 0;
    }
    li.chip {
        background-color: var(--accent-glow);
        border-radius: 10px;
        padding: 0.1rem 0.3rem;
        list-style: none;
        font-size: 0.8rem;
    }
    @media (max-width: 600px) {
        .chips {
            gap: 0.2rem;
        }
        .chip {
            padding: 0.1rem 0.2rem;
        }
    }
</style>
