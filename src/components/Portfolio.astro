---
import Chips from "./ui/Chips.astro";
import { personalProfile } from "../lib/personalProfile";
---

<section class="portfolio" aria-labelledby="proyectos">
  <h2 id="proyectos">Proyectos</h2>

  <div class="projects-grid">
    {
      personalProfile.projects.map((project) => (
        <article class="project-card">
          <h3>
            {project.url ? (
              <a href={project.url} target="_blank" rel="noopener noreferrer">
                {project.name} ↗
              </a>
            ) : (
              project.name
            )}
          </h3>
          <p class="project-status">{project.status}</p>
          <p>{project.description}</p>
          <Chips chips={project.tech} />
        </article>
      ))
    }
  </div>
</section>

<style>
  .portfolio {
    padding: 1rem 0;
  }

  .portfolio h2 {
    font-weight: 700;
    border-bottom: 3px dashed var(--text-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .project-card:hover {
    border-color: var(--text-muted);
  }

  .project-card h3 {
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
  }

  .project-status {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .project-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }
</style>
