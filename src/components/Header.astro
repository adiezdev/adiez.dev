---
import { SITE_AUTHOR } from "../consts";
import SocialLinks from "./SocialLinks.astro";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav>
		<a href="/" class="logo" aria-label="Ir al inicio">
			<span class="logo-text">{SITE_AUTHOR}</span>
		</a>

		<div class="nav-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/ai">Modo IA</HeaderLink>
		</div>

		<!-- Mobile Menu Button -->
		<button
			class="mobile-menu-btn"
			aria-label="Abrir menú"
			aria-expanded="false"
		>
			<span class="hamburger"></span>
		</button>
	</nav>

	<!-- Mobile Navigation -->
	<div class="mobile-nav" hidden>
		<HeaderLink href="/">Home</HeaderLink>
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/about">About</HeaderLink>
		<HeaderLink href="/ai">Modo IA</HeaderLink>
		<div class="mobile-social">
			<SocialLinks size={20} />
		</div>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(12, 12, 14, 0.95);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border-color);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		gap: 2rem;
	}

	/* Logo */
	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
	}

	.logo-text {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.03em;
	}

	/* Nav Links Container */
	.nav-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 10px;
	}

	/* Mobile Menu Button */
	.mobile-menu-btn {
		display: none;
		width: 44px;
		height: 44px;
		padding: 0;
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 10px;
		cursor: pointer;
	}

	.hamburger {
		position: relative;
		display: block;
		width: 18px;
		height: 2px;
		margin: 0 auto;
		background: var(--text-primary);
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	.hamburger::before,
	.hamburger::after {
		content: "";
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--text-primary);
		border-radius: 2px;
		transition: all 0.3s ease;
	}

	.hamburger::before {
		top: -6px;
	}

	.hamburger::after {
		bottom: -6px;
	}

	.mobile-menu-btn[aria-expanded="true"] .hamburger {
		background: transparent;
	}

	.mobile-menu-btn[aria-expanded="true"] .hamburger::before {
		top: 0;
		transform: rotate(45deg);
	}

	.mobile-menu-btn[aria-expanded="true"] .hamburger::after {
		bottom: 0;
		transform: rotate(-45deg);
	}

	/* Mobile Navigation */
	.mobile-nav {
		display: none;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1rem 1.5rem 1.5rem;
		border-top: 1px solid var(--border-color);
		background: var(--bg-primary);
	}

	.mobile-nav:not([hidden]) {
		display: flex;
	}

	.mobile-social {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-color);
	}

	.mobile-social :global(a) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		color: var(--text-muted);
		background: var(--bg-secondary);
		border: 1px solid var(--border-color);
		border-radius: 10px;
	}

	.mobile-social :global(a:hover) {
		color: var(--text-primary);
		border-color: var(--text-muted);
	}

	/* Responsive */
	@media (max-width: 768px) {
		nav {
			padding: 0.75rem 1rem;
		}

		.nav-links {
			display: none;
		}

		.mobile-menu-btn {
			display: flex;
			align-items: center;
			justify-content: center;
		}
	}

	@media (min-width: 769px) {
		.mobile-nav {
			display: none !important;
		}
	}
</style>

<script>
	const mobileMenuBtn = document.querySelector(".mobile-menu-btn");
	const mobileNav = document.querySelector(
		".mobile-nav",
	) as HTMLElement | null;

	mobileMenuBtn?.addEventListener("click", () => {
		const isExpanded =
			mobileMenuBtn.getAttribute("aria-expanded") === "true";
		mobileMenuBtn.setAttribute("aria-expanded", (!isExpanded).toString());

		if (mobileNav) {
			mobileNav.hidden = isExpanded;
		}
	});
</script>
